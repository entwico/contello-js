{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {},
    "test": {},
    "//#test": {
      "dependsOn": ["@contello/client#build", "@contello/media#build", "@contello/opentelemetry#build", "@contello/store#build"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
