{
  "name": "demo-astro",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "generate": "node --env-file=../../.env ../../packages/client/dist/cli.js generate",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test:e2e": "astro build && vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@astroscope/i18n": "^1.0.2",
    "@astroscope/node": "^1.3.0",
    "@contello/astro": "workspace:^",
    "@contello/client": "workspace:^",
    "@contello/store": "workspace:^",
    "@entwico/zod-conf": "^1.1.2",
    "astro": "^7.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
