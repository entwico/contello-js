{
  "name": "contello-js",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/contello-js"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate": "turbo run test lint typecheck",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@entwico/eslint-config": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.4",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
