{
  "name": "@contello/store",
  "version": "4.4.1",
  "description": "Framework-agnostic store for Contello CMS with reactive collections and automatic dependency tracking",
  "type": "module",
  "license": "MIT",
  "author": "admin@entwico.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/contello-js",
    "directory": "packages/store"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "node --env-file=../../.env ../client/dist/cli.js generate",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contello/opentelemetry": "workspace:^",
    "@entwico/dash": "^1.3.0",
    "@entwico/projected": "^5.0.0",
    "lru-cache": "^11.5.3"
  },
  "peerDependencies": {
    "@contello/client": "workspace:^",
    "@contello/media": "workspace:^"
  },
  "devDependencies": {
    "@contello/client": "workspace:^",
    "@contello/media": "workspace:^"
  },
  "files": [
    "dist",
    "fragments"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fragments": {
      "types": "./dist/fragments.d.ts",
      "import": "./dist/fragments.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
