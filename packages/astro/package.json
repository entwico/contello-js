{
  "name": "@contello/astro",
  "version": "4.4.1",
  "description": "Astro integration for Contello CMS — assets and routing middlewares, i18n bridge",
  "keywords": [
    "astro",
    "astro-integration",
    "contello",
    "cms"
  ],
  "type": "module",
  "license": "MIT",
  "author": "admin@entwico.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/contello-js",
    "directory": "packages/astro"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contello/opentelemetry": "workspace:^",
    "@entwico/dash": "^1.3.0"
  },
  "peerDependencies": {
    "@astroscope/i18n": "^3.0.0",
    "@astroscope/node": "^4.1.0",
    "@contello/client": "workspace:^",
    "@contello/media": "workspace:^",
    "@contello/store": "workspace:^",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@astroscope/i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astroscope/i18n": "^3.0.0",
    "@astroscope/node": "^4.1.0",
    "@contello/client": "workspace:^",
    "@contello/media": "workspace:^",
    "@contello/store": "workspace:^",
    "astro": "^7.3.8",
    "vite": "^8.2.2"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets-middleware": {
      "import": "./dist/assets-middleware-entrypoint.js"
    },
    "./routing-middleware": {
      "import": "./dist/routing-middleware-entrypoint.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
